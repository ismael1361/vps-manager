{
    "compilerOptions": {
        "target": "es2020",
        "types": [
            "node",
            "jest"
        ],
        "lib": [
            "es2020"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": false,
        "declaration": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "declarationDir": "./dist",
        "declarationMap": true,
        "sourceMap": true,
        "importHelpers": true,
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}