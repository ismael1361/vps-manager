<addon>
    <script>
        async function install() {
            var isInstalled = await executeTrigger("installed").then(function (result) { return result.trim() !== ""; });
            if (!isInstalled) {
                await executeTrigger("install");
                await executeTrigger("ufw_allow");
            }
            await $super.updateConfig({ nginxInstalled: true, installedAt: new Date().toISOString() });
            await $super.notify("Nginx Manager installed successfully.", "success");
        }

        async function initialize() {
            var isInstalled = await executeTrigger("installed").then(function (result) { return result.trim() !== ""; });
            if (!isInstalled) {
                await $super.notify("Nginx not found on VPS — removing addon configuration.", "error");
                await $super.uninstall();
            }
        }

        async function uninstall() {
            var isInstalled = await executeTrigger("installed").then(function (result) { return result.trim() !== ""; });
            if (isInstalled) {
                await executeTrigger("uninstall");
            }
            await $super.notify("Nginx Manager uninstalled.", "info");
            await $super.uninstall();
        }
    </script>
    <triggers>
        <trigger event="install">
            <actions>
                <command>sudo apt update && sudo apt upgrade -y</command>
                <command>sudo apt install -y nginx</command>
                <command>sudo systemctl start nginx</command>
                <command>sudo systemctl enable nginx</command>
            </actions>
        </trigger>
        <trigger event="installed">
            <actions>
                <command>which nginx</command>
            </actions>
        </trigger>
        <trigger event="ufw_allow">
            <actions>
                <command>sudo ufw allow 'Nginx Full'</command>
                <command>sudo ufw reload</command>
            </actions>
        </trigger>
        <trigger event="uninstall">
            <actions>
                <command>sudo apt remove -y nginx</command>
                <command>sudo apt autoremove -y</command>
            </actions>
        </trigger>
        <trigger event="status">
            <actions>
                <command>sudo systemctl status nginx --no-pager</command>
            </actions>
        </trigger>
        <trigger event="restart">
            <actions>
                <command>sudo systemctl restart nginx</command>
            </actions>
        </trigger>
        <trigger event="reload">
            <actions>
                <command>sudo systemctl reload nginx</command>
            </actions>
        </trigger>
        <trigger event="enable">
            <actions>
                <command>sudo systemctl enable nginx</command>
            </actions>
        </trigger>
        <trigger event="disable">
            <actions>
                <command>sudo systemctl disable nginx</command>
            </actions>
        </trigger>
        <trigger event="list_sites">
            <actions>
                <command>ls /etc/nginx/sites-available</command>
            </actions>
        </trigger>
        <trigger event="list_enabled_sites">
            <actions>
                <command>ls /etc/nginx/sites-enabled</command>
            </actions>
        </trigger>
        <trigger event="create_site">
            <actions>
                <command>echo "{content}" | sudo tee /etc/nginx/sites-available/{domain}</command>
                <command>sudo ln -s /etc/nginx/sites-available/{domain} /etc/nginx/sites-enabled/</command>
                <command>sudo nginx -t</command>
                <command>sudo systemctl reload nginx</command>
            </actions>
            <inputs>
                <input name="domain" type="text" />
                <input name="content" type="text" />
            </inputs>
        </trigger>
        <trigger event="delete_site">
            <actions>
                <command>sudo rm -f /etc/nginx/sites-available/{domain}</command>
                <command>sudo rm -f /etc/nginx/sites-enabled/{domain}</command>
                <command>sudo nginx -t</command>
                <command>sudo systemctl reload nginx</command>
            </actions>
            <inputs>
                <input name="domain" type="text" />
            </inputs>
        </trigger>
        <trigger event="read_site">
            <actions>
                <command>cat /etc/nginx/sites-available/{domain}</command>
            </actions>
            <inputs>
                <input name="domain" type="text" />
            </inputs>
        </trigger>
        <trigger event="edit_site">
            <actions>
                <command>echo "{content}" | sudo tee /etc/nginx/sites-available/{domain}</command>
                <command>sudo nginx -t</command>
                <command>sudo systemctl reload nginx</command>
            </actions>
            <inputs>
                <input name="domain" type="text" />
                <input name="content" type="text" />
            </inputs>
        </trigger>
        <trigger event="test_configuration">
            <actions>
                <command>sudo nginx -t</command>
            </actions>
        </trigger>
    </triggers>
    <views>
        <view name="Dashboard">
            <script>
                setState("sites", []);
                setState("status", "");

                await executeTrigger("list_sites").then(result => {
                    setState("sites", () => result.split("\n").filter(site => site.trim() !== ""));
                });
                await executeTrigger("status").then(result => {
                    setState("status", () => "Service status: \n" + result);
                });
                setState("status", (prev) => prev + "\n----------------\n\n");
                await executeTrigger("test_configuration").then(result => {
                    setState("status", (prev) => prev + "Config syntax: \n" + result);
                });
            </script>

            <template>
                <h1>Nginx Dashboard</h1>
                <p>Use the triggers to manage your Nginx installation and sites.</p>
                <h2>Installed Sites</h2>
                <ul>
                    {{state.sites.map(site => `<li>${site}</li>`).join("")}}
                </ul>
                <h2>Status</h2>
                <code>{{state.status || "Loading..."}}</code>
            </template>

            <style>
                button,
                a {
                    display: block;
                    margin-bottom: 1em;

                }

                code {
                    display: block;
                    background: rgba(0, 0, 0, 0.2);
                    color: currentColor;
                    padding: 1em;
                    white-space: pre-wrap;
                    opacity: 0.8;
                }
            </style>
        </view>
        <view name="Manage Sites">
            <script>
                setState("sites_list", []);
                setState("site_selected", null);
                setState("site_content", "");

                function oninput(event) {
                    event.preventDefault();
                    state.site_content = event.target.value;
                }

                async function refreshSites() {
                    await executeTrigger("list_sites").then(result => {
                        setState("sites_list", () => result.replace(/\r/g, "").split("\n").filter(site => site.trim() !== ""));
                    });
                }

                await refreshSites();

                async function backToList() {
                    setState("site_selected", null);
                    setState("site_content", "");
                    await refreshSites();
                }

                async function selectSite(site) {
                    setState("site_selected", site);
                    setState("site_content", await executeTrigger("read_site", { domain: site }));
                }

                async function deleteSite(domain) {
                    if (confirm(`Are you sure you want to delete the site "${domain}"? This action cannot be undone.`)) {
                        await executeTrigger("delete_site", { domain });
                        alert(`Site "${domain}" has been deleted.`);
                        setState("site_selected", null);
                        setState("site_content", "");
                        // Refresh the sites list
                        await refreshSites();
                    }
                }

                async function saveSite(domain) {
                    await executeTrigger("edit_site", { domain, content: state.site_content });
                    alert(`Site "${domain}" has been updated.`);
                }
            </script>
            <template if="!state.site_selected">
                <h1>Manage Nginx Sites</h1>
                <p>Select a site to view or edit its configuration.</p>
                <ul class="sites-list">
                    {{state.sites_list.length > 0 ? state.sites_list.map(site => `<li><a href="#"
                            onclick="selectSite('${site}')">${site}</a></li>
                    `).join("") : "<li>No sites available</li>"}}
                </ul>
            </template>
            <template if="state.site_selected">
                <h1>Site: {{state.site_selected}}</h1>
                <textarea oninput="oninput(event)" style="width: 100%; height: 300px;">{{state.site_content}}</textarea>
                <button onclick="saveSite(state.site_selected)">Save Site</button>
                <button onclick="deleteSite(state.site_selected)"
                    style="background-color: #e53e3e; color: white;">Delete
                    Site</button>
                <button onclick="backToList()">Back to Sites List</button>
            </template>
            <style>
                form {
                    display: flex;
                    flex-direction: column;
                    max-width: 400px;
                }

                label {
                    margin-top: 1em;
                }

                input {
                    width: 100%;
                    padding: 0.5em;
                    margin-top: 0.5em;
                }

                button {
                    margin-top: 1em;
                    padding: 0.5em;
                }

                .sites-list {
                    list-style: none;
                    padding: 0;
                }
            </style>
        </view>
        <view name="Create Site">
            <script>
                async function createSite(domain, content) {
                    await executeTrigger('create_site', { domain, content });
                }

                async function submitForm(event) {
                    event.preventDefault();
                    const domain = document.getElementById('domain').value;
                    const content = document.getElementById('content').value;
                    await createSite(domain, content);
                }
            </script>
            <template>
                <h1>Create Nginx Site</h1>
                <p>Use the form below to create a new Nginx site.</p>
                <form onsubmit="submitForm(event)">
                    <label for="domain">Domain:</label>
                    <input type="text" id="domain" name="domain" placeholder="example.com" required>
                    <br>
                    <label for="content">Configuration:</label>
                    <textarea id="content" name="content" placeholder="server {
    listen 80;
    server_name example.com;

    location / {
        root /var/www/html;
        index index.html;
    }
}" required></textarea>
                    <br>
                    <button type="submit">Create Site</button>
                </form>
            </template>
            <style>
                form {
                    display: flex;
                    flex-direction: column;
                    max-width: none !important;
                }

                label {
                    margin-top: 1em;
                }

                input,
                textarea {
                    width: 100%;
                    padding: 0.5em;
                    margin-top: 0.5em;
                }

                button {
                    margin-top: 1em;
                    padding: 0.5em;
                }
            </style>
        </view>
    </views>
</addon>